# Dùng SQLite (đơn giản, phù hợp demo)
DATABASE_URL=sqlite:///./app.db

# Hoặc PostgreSQL nếu dùng Render database
# DATABASE_URL=postgresql://user:password@host:5432/foodrec

# Secret key (tự generate khi deploy)
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# URL frontend Vercel (để CORS)
FRONTEND_URL=https://your-app.vercel.app
